<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contract with the Ente web app, and its client's test vectors (CONTRACT.md). -->
    <Content Include="..\..\contract\vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\contract\ente-homebase.json" Link="ente-homebase.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EnteHomebaseProxy\EnteHomebaseProxy.csproj" />
  </ItemGroup>

</Project>